{
  "name": "sw-jscad-viewer",
  "version": "0.1.4",
  "description": "JSCAD viewer leveraging swcad-js",
  "main": "index.js",
  "workspaces": [
    "packages/*",
    "apps/sw-jscad-web"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "info": "echo This is a monorepo, that holds jsadui libraries and example apps. && echo If you want to try some apps made with jscadui go to apps folder. && echo Please read README for introduction and list of apps and info how ready or usable each is",
    "start": "npm run start -w sw-jscad-web",
    "dev": " npm run start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvador-workshop/sw-jscad-viewer.git"
  },
  "keywords": [
    "jscad",
    "typescript",
    "javascript",
    "ui",
    "web",
    "regl",
    "threejs"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/salvador-workshop/sw-jscad-viewer"
  },
  "homepage": "https://github.com/salvador-workshop/sw-jscad-viewer",
  "devDependencies": {
    "turbo": "1.6.3"
  }
}
